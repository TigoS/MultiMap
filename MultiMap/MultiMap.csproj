<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net11.0;net10.0;net9.0;net8.0</TargetFrameworks>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet Package Metadata -->
    <PackageId>MultiMap</PackageId>
    <Version>3.2.0</Version>
    <Authors>TigoS</Authors>
    <Description>A .NET library providing various multimap implementations — generic collections that associate each key with one or more values. Includes list-based, set-based, sorted, concurrent, reader-writer locked, and async variants with set-like extension methods. Targets .NET 11, .NET 10, .NET 9, and .NET 8.</Description>
    <PackageTags>multimap;dictionary;collection;concurrent;async;sorted;data-structures</PackageTags>
    <RepositoryUrl>https://github.com/TigoS/MultiMap</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Generate XML documentation for IntelliSense in consuming projects -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Title>Collections that maps each key to one or more values</Title>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
    <PackageIcon Condition="Exists('..\icons8-nuget-shadow\icons8-nuget-48.png')">icons8-nuget-48.png</PackageIcon>
    <Copyright>© 2026 TigoS</Copyright>
    <PackageReleaseNotes>3.2.0

- Performance: Optimized Values enumeration, added span-based TryGetSpan retrieval, and batched RemoveRange processing
- Testing: Added four FsCheck/NUnit property tests and BenchmarkDotNet remove-range regression benchmarks
- Coverage: Fresh all-TFM run reports 97.28% line, 94.56% branch, and 98.94% method coverage
- Tests: 9,752 executions across net11.0, net10.0, net9.0, and net8.0 with zero failures
- Documentation: Updated README, testing, benchmarks, release notes, badges, and Review documentation

See the full Release Notes history: https://github.com/TigoS/MultiMap/blob/master/Docs/ReleaseNotes.md</PackageReleaseNotes>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
  </PropertyGroup>

  <ItemGroup>
	<None Include="..\icons8-nuget-shadow\icons8-nuget-48.png" Link="Icons\icons8-nuget-48.png" Pack="true" PackagePath="\" Condition="Exists('..\icons8-nuget-shadow\icons8-nuget-48.png')" />
	<None Include="..\LICENSE.txt" Pack="true" PackagePath="\" />
	<None Include="..\README.md" Pack="true" PackagePath="\" />
	<None Include="..\Docs\ReleaseNotes.md" Pack="true" PackagePath="\" Link="Docs\ReleaseNotes.md" />
	<None Include="..\Docs\Benchmarks.md" Pack="true" PackagePath="\" Link="Docs\Benchmarks.md" />
	<None Include="..\Docs\MigrationGuide.md" Pack="true" PackagePath="\" Link="Docs\MigrationGuide.md" />
	<None Include="..\Docs\Testing.md" Pack="true" PackagePath="\" Link="Docs\Testing.md" />
    <None Include="..\Docs\ImplementationGuide.md" Pack="true" PackagePath="\" Link="Docs\ImplementationGuide.md" />
    <None Include="..\Docs\UsagePatterns.md" Pack="true" PackagePath="\" Link="Docs\UsagePatterns.md" />
    <None Include="..\Docs\CommonMistakes.md" Pack="true" PackagePath="\" Link="Docs\CommonMistakes.md" />
    <None Include="..\Docs\ADRs\ADR-001-MultiMapAsync-Reader-Writer-Protocol.md" Pack="true" PackagePath="\" Link="Docs\ADRs\ADR-001-MultiMapAsync-Reader-Writer-Protocol.md" />
    <None Include="..\Docs\ADRs\ADR_README.md" Pack="true" PackagePath="\" Link="Docs\ADRs\ADR_README.md" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Icons\" />
  </ItemGroup>

</Project>
